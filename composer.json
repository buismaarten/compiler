{
    "name": "buismaarten/parser",
    "description": "",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/buismaarten/parser/issues",
        "source": "https://github.com/buismaarten/parser"
    },
    "require": {
        "php": "^8.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Package\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Package\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan analyse -c ./phpstan.neon --no-progress",
        "test": "./vendor/bin/phpunit --testdox --no-progress"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
