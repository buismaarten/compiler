{
    "name": "buismaarten/compiler",
    "description": "",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/buismaarten/compiler/issues",
        "source": "https://github.com/buismaarten/compiler"
    },
    "require": {
        "php": "^8.6",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Package\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Package\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan analyse -c ./phpstan.neon --no-progress",
        "test": "./vendor/bin/phpunit --no-progress"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
